{
  "RoleName": "product-assistant-lambda",
  "Arn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/product-assistant-lambda",
  "AttachedManagedPolicies": [
    {"PolicyName": "AWSLambdaBasicExecutionRole", "PolicyArn": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"}
  ],
  "InlinePolicies": [
    {
      "PolicyName": "assistant-runtime",
      "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {"Sid": "Bedrock", "Effect": "Allow", "Action": "bedrock:*", "Resource": "*"},
          {
            "Sid": "ChatHistory",
            "Effect": "Allow",
            "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query"],
            "Resource": "arn:aws:dynamodb:us-east-1:YOUR_AWS_ACCOUNT_ID:table/product-assistant-chat-history"
          }
        ]
      }
    }
  ]
}
